# Local self-host (toy agent / hook_server.py / ws_relay.py) only needs
# GROQ_API_KEY / LLM_BACKEND / OTEL_COLLECTOR_ENDPOINT / SIGNOZ_API_KEY,
# same as before -- see the existing .env (gitignored, not this file).
#
# The vars below are only read by the hosted backend (main.py):

# Supabase "Transaction pooler" connection string (port 6543) -- Project
# Settings -> Database -> Connection string in the Supabase dashboard.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Project Settings -> API -> JWT Secret in the Supabase dashboard.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# The deployed frontend's real origin, once it exists -- tightens CORS
# from the wide-open default. e.g. https://app.your-domain.example
FRONTEND_ORIGIN=*

PORT=8080
