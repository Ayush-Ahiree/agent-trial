# Copy to .env for hosted mode (Supabase login + the deployed FastAPI
# backend). Leave unset / delete .env entirely for local self-host mode
# against `python cli.py start` -- see src/lib/config.js's HOSTED flag.

VITE_API_BASE=https://api.your-domain.example
VITE_WS_BASE=wss://api.your-domain.example
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
